# Canary Wallet Self-Hosted Mode Configuration
# Copy this file to .env for self-hosted single-user deployment

#############################################
# OPERATING MODE
#############################################

# Self-hosted mode: Single user, password-protected, no billing, self-hosted notifications
CANARY_MODE=self-hosted

#############################################
# REQUIRED CONFIGURATION
#############################################

# Network Configuration
CANARY_NETWORK=regtest
CANARY_ELECTRUM_URL=tcp://127.0.0.1:50001
CANARY_BIND_ADDRESS=127.0.0.1:3000

# Required browser origin. This is the only origin allowed to make credentialed API requests.
FRONTEND_URL=http://localhost:3001

# Optional additional browser origins, comma-separated. Node platforms that
# expose Canary through several enabled addresses should provide all of them.
# FRONTEND_URLS=https://canary.local:443,http://192.168.1.10:3001

# Per-wallet freshness target (OPTIONAL)
# Canary serializes script-heavy work against a self-hosted Electrum endpoint. Faster nodes
# complete the queue sooner; if aggregate wallet work exceeds this target, wallets remain fairly
# serviced in oldest-first order but may sync later. This is not a guaranteed latency SLA.
# Network defaults: regtest=30, testnet=60, mainnet=300 seconds. Node packages may override it.
# CANARY_SYNC_INTERVAL=300

# Storage Configuration
CANARY_DATA_DIR=./database/self-hosted

# Authentication Configuration
# Required for the built-in admin account (email: admin@local)
JWT_SECRET=replace-with-a-long-random-secret
CANARY_SELF_HOSTED_ADMIN_PASSWORD=replace-with-a-strong-password

#############################################
# NTFY NOTIFICATION SERVER
#############################################

# Custom ntfy server URL (OPTIONAL)
# Default: https://ntfy.sh (public server)
# Self-host your own ntfy server: https://ntfy.sh/docs/install/
# NTFY_SERVER_URL=https://ntfy.example.com
# Most operators should not set this manually; Umbrel exports.sh sets it automatically.
# Use NTFY_SERVER_URL for custom servers outside detected app integrations.
# CANARY_UMBREL_NTFY_URL=http://ntfy_app_1
#
# Package-provisioned local ntfy defaults (OPTIONAL)
# StartOS packages can set these after calling ntfy's provision-publisher action.
# These values are defaults only; user-saved Canary Wallet Settings still win.
# CANARY_NTFY_SERVER_URL=http://ntfy.startos
# CANARY_NTFY_TOKEN=tk_...
# CANARY_NTFY_TOPIC=canary

#############################################
# SELF-HOSTED MODE FEATURES
#############################################

# ✅ Single built-in admin user (sign in as admin@local)
# ✅ Password-protected API and UI
# ✅ No subscription billing or limits
# ✅ ntfy notifications with custom server support
# ✅ Nostr DM notifications from the local Canary instance identity
# ✅ Use your own Bitcoin/Electrum nodes
# ✅ Fully self-hostable; optional Nostr DMs need outbound relay access
#
# Nostr sender identity note:
# Canary generates a local Nostr sender key and stores it in the SQLite database.
# Back up the database to preserve the sender npub across reinstalls. Anyone with
# database access can impersonate this Canary sender identity. Nostr delivery uses
# public discovery relays by default, so allow outbound WebSocket access or run
# Canary behind relay egress rules that match your privacy model.

#############################################
# EXAMPLE CONFIGURATIONS
#############################################

# For Bitcoin Core + Electrum Personal Server:
# CANARY_NETWORK=mainnet
# CANARY_ELECTRUM_URL=tcp://localhost:50002

# For Umbrel/Start9 deployment:
# CANARY_NETWORK=mainnet
# CANARY_ELECTRUM_URL=tcp://umbrel.local:50002
# CANARY_BIND_ADDRESS=0.0.0.0:3000

# For testnet development:
# CANARY_NETWORK=testnet
# CANARY_ELECTRUM_URL=ssl://electrum.blockstream.info:60002

# For fully self-hosted setup with your own ntfy server:
# CANARY_NETWORK=mainnet
# CANARY_ELECTRUM_URL=tcp://localhost:50002
# NTFY_SERVER_URL=https://ntfy.yourdomain.com

#############################################
# TRANSACTION EXPLORERS
#############################################

# Custom explorer URLs for transaction links (OPTIONAL)
# Default: https://mempool.space (public instance)
# Set these to point to your own explorer instances:
# CANARY_MEMPOOL_URL=http://umbrel.local:3006
# CANARY_BITFEED_URL=http://umbrel.local:8314
# CANARY_BTC_RPC_EXPLORER_URL=http://umbrel.local:3002
#
# Packaging layers can also provide multiple browser-facing URLs for one explorer.
# Canary Wallet will choose the URL matching the hostname used to open Canary Wallet when possible.
# If both the singular URL and URLS list are set for an explorer, the singular
# URL is kept as the primary fallback and deduplicated into the candidate list.
# CANARY_MEMPOOL_URLS=https://example-node.local:52127,https://203.0.113.10:52127
# CANARY_BITFEED_URLS=https://example-node.local:8314,https://203.0.113.10:8314
# CANARY_BTC_RPC_EXPLORER_URLS=https://example-node.local:49389,https://203.0.113.10:49389

# On Umbrel, explorers can be auto-detected via ports set by exports.sh:
# CANARY_MEMPOOL_PORT=3006
# CANARY_BITFEED_PORT=8314
# CANARY_BTC_RPC_EXPLORER_PORT=3002
# CANARY_TX_EXPLORER_PLATFORM=umbrel

#############################################
# DEVELOPMENT OPTIONS
#############################################

# Enable file logging (writes to logs/backend.log)
# Only for local development - Docker/Umbrel captures stdout automatically
# CANARY_FILE_LOGGING=true
