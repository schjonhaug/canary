# Canary Self-Hosted Mode Configuration
# Copy this file to .env for self-hosted single-user deployment

#############################################
# OPERATING MODE
#############################################

# Self-hosted mode: Single user, password-protected, no billing, ntfy-only notifications
CANARY_MODE=self-hosted

#############################################
# REQUIRED CONFIGURATION
#############################################

# Network Configuration
CANARY_NETWORK=regtest
CANARY_ELECTRUM_URL=tcp://127.0.0.1:50001
CANARY_BIND_ADDRESS=127.0.0.1:3000

# Storage Configuration
CANARY_DATA_DIR=./database/self-hosted

# Authentication Configuration
# Required for the built-in admin account (email: admin@local)
JWT_SECRET=replace-with-a-long-random-secret
CANARY_SELF_HOSTED_ADMIN_PASSWORD=replace-with-a-strong-password

#############################################
# NTFY NOTIFICATION SERVER
#############################################

# Custom ntfy server URL (OPTIONAL)
# Default: https://ntfy.sh (public server)
# Self-host your own ntfy server: https://ntfy.sh/docs/install/
# NTFY_SERVER_URL=https://ntfy.example.com
# On Umbrel, exports.sh sets this automatically when the ntfy app is installed.
# Most operators should not set this manually; Umbrel exports.sh sets it automatically.
# Use NTFY_SERVER_URL for custom servers outside detected app integrations.
# CANARY_UMBREL_NTFY_URL=http://ntfy_app_1

#############################################
# SELF-HOSTED MODE FEATURES
#############################################

# ✅ Single built-in admin user (sign in as admin@local)
# ✅ Password-protected API and UI
# ✅ No subscription billing or limits
# ✅ ntfy notifications with custom server support
# ✅ Use your own Bitcoin/Electrum nodes
# ✅ Fully self-hostable with no external dependencies

#############################################
# EXAMPLE CONFIGURATIONS
#############################################

# For Bitcoin Core + Electrum Personal Server:
# CANARY_NETWORK=mainnet
# CANARY_ELECTRUM_URL=tcp://localhost:50002

# For Umbrel/Start9 deployment:
# CANARY_NETWORK=mainnet
# CANARY_ELECTRUM_URL=tcp://umbrel.local:50002
# CANARY_BIND_ADDRESS=0.0.0.0:3000

# For testnet development:
# CANARY_NETWORK=testnet
# CANARY_ELECTRUM_URL=ssl://electrum.blockstream.info:60002

# For fully self-hosted setup with your own ntfy server:
# CANARY_NETWORK=mainnet
# CANARY_ELECTRUM_URL=tcp://localhost:50002
# NTFY_SERVER_URL=https://ntfy.yourdomain.com

#############################################
# TRANSACTION EXPLORERS
#############################################

# Custom explorer URLs for transaction links (OPTIONAL)
# Default: https://mempool.space (public instance)
# Set these to point to your own explorer instances:
# CANARY_MEMPOOL_URL=http://umbrel.local:3006
# CANARY_BITFEED_URL=http://umbrel.local:8314
# CANARY_BTC_RPC_EXPLORER_URL=http://umbrel.local:3002

# On Umbrel, explorers can be auto-detected via ports set by exports.sh:
# CANARY_MEMPOOL_PORT=3006
# CANARY_BITFEED_PORT=8314
# CANARY_BTC_RPC_EXPLORER_PORT=3002

#############################################
# DEVELOPMENT OPTIONS
#############################################

# Enable file logging (writes to logs/backend.log)
# Only for local development - Docker/Umbrel captures stdout automatically
# CANARY_FILE_LOGGING=true
