# Canary Cloud Mode Configuration
# Copy this file to .env for hosted service deployment

#############################################
# OPERATING MODE
#############################################

# Cloud mode: Multi-user authentication, subscription billing, all notification providers
CANARY_MODE=cloud

#############################################
# REQUIRED CONFIGURATION
#############################################

# Network Configuration
CANARY_NETWORK=mainnet
CANARY_ELECTRUM_URL=ssl://electrum.blockstream.info:50002
CANARY_BIND_ADDRESS=0.0.0.0:3000

# Storage Configuration
CANARY_DATA_DIR=./database/cloud

#############################################
# AUTHENTICATION & SECURITY
#############################################

# JWT Secret for session management (REQUIRED)
# IMPORTANT: Generate a secure random secret for production!
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET

#############################################
# STRIPE BILLING
#############################################

# Stripe configuration for subscription billing (REQUIRED)
# Get these from your Stripe dashboard: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret_here

#############################################
# TWILIO SMS
#############################################

# Twilio configuration for SMS notifications and verification (REQUIRED)
# Get these from your Twilio console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
# SMS sender ID: alphanumeric name (e.g., "Canary"), phone number, or Messaging Service SID
# Alphanumeric IDs display your brand name instead of a phone number (one-way only)
# Note: Not all countries support alphanumeric sender IDs (US doesn't, Norway does)
TWILIO_SENDER_ID=Canary
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#############################################
# EMAIL SERVICE
#############################################

# Resend configuration for email notifications and verification (REQUIRED)
# Get these from your Resend dashboard: https://resend.com/
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=notifications@canarybitcoin.com
RESEND_FROM_NAME=Canary Wallet
RESEND_AUDIENCE_ID=your_audience_id

# Contact form recipient email (defaults to RESEND_FROM_EMAIL if not set)
CONTACT_FORM_EMAIL=mail@canarybitcoin.com

#############################################
# FRONTEND URL
#############################################

# Frontend URL for email verification and password reset links (REQUIRED)
FRONTEND_URL=https://your-domain.com

#############################################
# ADMIN NOTIFICATIONS
#############################################

# ntfy.sh topic for admin notifications (OPTIONAL)
# Get notified when new users register and wallets are created
# Subscribe at: https://ntfy.sh/your-admin-topic
ADMIN_NOTIFICATION_TOPIC=canary-admin-alerts

#############################################
# BTCPAY SERVER
#############################################

# BTCPay Server integration for donation page redirects (REQUIRED)
# Self-hosted instances link to cloud API endpoints which redirect to BTCPay
# Get an API key from your BTCPay Server with scopes:
#   btcpay.store.cancreateinvoice, btcpay.store.canmanagesubscribers
BTCPAY_URL=https://btcpay.enogtjue.no
BTCPAY_API_KEY=your_btcpay_api_key_here
BTCPAY_STORE_ID=your_btcpay_store_id_here
BTCPAY_OFFERING_ID=your_btcpay_offering_id_here
BTCPAY_PLAN_ID=your_btcpay_plan_id_here

#############################################
# CLOUD MODE FEATURES
#############################################

# ✅ Multi-user with email/password authentication
# ✅ Stripe subscription billing with tier-based limits
# ✅ Multiple notification providers (SMS, email, ntfy)
# ✅ Email verification and password reset
# ✅ Professional billing management and customer portal
# ✅ Real-time webhook processing for subscription changes

#############################################
# DEVELOPMENT OPTIONS
#############################################

# Enable file logging (writes to logs/backend.log)
# Only for local development - Docker/Umbrel captures stdout automatically
# CANARY_FILE_LOGGING=true
