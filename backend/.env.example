# Canary Configuration Example
# Copy this file to .env and update values as needed

# Authentication Configuration
# Set to true for SAAS mode (requires login), false for self-hosted mode (no login)
CANARY_ENABLE_AUTH=false

# JWT secret for token signing (required if CANARY_ENABLE_AUTH=true)
# IMPORTANT: Change this in production!
#JWT_SECRET=your-secret-key-change-in-production

# Notification Providers
# Enable/disable specific notification providers
CANARY_ENABLE_NTFY=true
CANARY_ENABLE_TWILIO=false

# Twilio SMS Configuration (required if CANARY_ENABLE_TWILIO=true)
# Get these from your Twilio console: https://console.twilio.com/
#TWILIO_ACCOUNT_SID=your_account_sid_here
#TWILIO_AUTH_TOKEN=your_auth_token_here
#TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid_or_phone_number

# Twilio Verify Configuration (required for SMS contact verification)
# Used for verifying phone numbers when adding SMS contacts
#TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email Service Configuration (required if CANARY_ENABLE_AUTH=true)
# Resend API settings for sending verification, password reset, and transaction notification emails
#RESEND_API_KEY=re_your-resend-api-key
#RESEND_FROM_EMAIL=notifications@canarybitcoin.com
#RESEND_FROM_NAME=Canary Wallet
#RESEND_AUDIENCE_ID=xxx

# Frontend URL for email links (required if CANARY_ENABLE_AUTH=true)
#FRONTEND_URL=http://localhost:3001

# Network Configuration
#CANARY_NETWORK=regtest
#CANARY_ELECTRUM_URL=tcp://127.0.0.1:50001
#CANARY_BIND_ADDRESS=127.0.0.1:3000
#CANARY_SYNC_INTERVAL=60  # Wallet sync interval in seconds (default: 60)

# Storage Configuration
#CANARY_DATA_DIR=./database

# Stripe Configuration (required for billing features)
# Get these from your Stripe dashboard: https://dashboard.stripe.com/
# Use test keys for development (sk_test_...) and live keys for production (sk_live_...)
#STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
#STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret_here

# Stripe Product Configuration
# Products should be created in Stripe dashboard with metadata:
# - tier=personal (for Personal tier)
# - tier=team (for Team tier)  
# - tier=business (for Business tier)
# Each product should have both monthly and yearly prices

# Yearly prices should include discounts directly in Stripe
# Configure upsells (yearly alternatives) in the Stripe Dashboard on monthly prices