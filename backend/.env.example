# Canary Configuration Example
# Copy this file to .env and update values as needed

#############################################
# OPERATING MODE (Required)
#############################################

# Set to "saas" for hosted service with authentication and billing
# Set to "foss" for self-hosted single-user mode (no auth, no billing, ntfy-only notifications)
CANARY_MODE=foss

#############################################
# COMMON CONFIGURATION (All Modes)
#############################################

# Network Configuration
#CANARY_NETWORK=regtest
#CANARY_ELECTRUM_URL=tcp://127.0.0.1:50001
#CANARY_BIND_ADDRESS=127.0.0.1:3000
#CANARY_SYNC_INTERVAL=60  # Wallet sync interval in seconds (default: 60)

# Storage Configuration
#CANARY_DATA_DIR=./database

#############################################
# FOSS MODE CONFIGURATION
#############################################

# For FOSS mode, set CANARY_MODE=foss and configure your Bitcoin node:
# CANARY_MODE=foss
# CANARY_ELECTRUM_URL=tcp://your-bitcoin-node:50001
# (That's it! No external services needed - uses only ntfy notifications)

#############################################
# SAAS MODE CONFIGURATION
#############################################

# ⚠️  ALL VARIABLES BELOW ARE REQUIRED FOR SAAS MODE
# The backend will refuse to start in SAAS mode without these configured

# Authentication & Security (REQUIRED)
JWT_SECRET=your-secret-key-change-in-production

# Stripe Billing (REQUIRED)
# Get these from your Stripe dashboard: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret_here

# Twilio SMS Configuration (REQUIRED)
# Get these from your Twilio console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid_or_phone_number
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email Service Configuration (REQUIRED)
# Resend API settings for sending verification, password reset, and transaction notification emails
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=notifications@canarybitcoin.com
RESEND_FROM_NAME=Canary Wallet
RESEND_AUDIENCE_ID=xxx

# Frontend URL (REQUIRED)
# Required for email verification and password reset links
FRONTEND_URL=http://localhost:3001

#############################################
# NOTES
#############################################

# FOSS Mode Features:
# - Single hardcoded admin user (no registration/login)
# - Uses your own Bitcoin/Electrum node
# - Only ntfy notifications (self-hostable)
# - No external service dependencies
# - No subscription limits

# SAAS Mode Features:
# - Multi-user with email/password authentication
# - Stripe subscription billing and limits
# - Multiple notification providers (ntfy, SMS, email)
# - Hosted Electrum servers
# - Email verification and password reset