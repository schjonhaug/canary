# Canary Frontend Configuration Example
# Copy this file to .env.local and update values as needed

#############################################
# OPERATING MODE (Required)
#############################################

# Set to "saas" for hosted service with authentication and billing
# Set to "foss" for self-hosted single-user mode (no auth, no billing)
NEXT_PUBLIC_CANARY_MODE=foss

#############################################
# COMMON CONFIGURATION (All Modes)
#############################################

# Backend API URL (optional)
# Used by frontend to communicate with the backend
# Default: http://localhost:3000 (backend running on same host)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Dashboard polling interval in milliseconds (optional)
# Should match the backend's CANARY_SYNC_INTERVAL * 1000
# Default: 60000 (60 seconds)
NEXT_PUBLIC_SYNC_INTERVAL=60000

#############################################
# FOSS MODE CONFIGURATION
#############################################

# For FOSS mode, just set the mode:
# NEXT_PUBLIC_CANARY_MODE=foss
# (That's it! No additional frontend config needed)

#############################################
# SAAS MODE CONFIGURATION  
#############################################

# Stripe Configuration (required for SAAS mode billing)
#NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

#############################################
# NOTES
#############################################

# FOSS Mode Features:
# - Single hardcoded admin user (no login UI)
# - No billing/subscription UI components
# - Simplified interface focused on wallet management

# SAAS Mode Features:
# - Full authentication UI (login, register, password reset)
# - Subscription billing and upgrade modals
# - Multi-user support with user profiles
# - Customer portal integration