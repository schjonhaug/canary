# Backend API URL (optional)
# Used by Next.js API routes to proxy requests to the backend
# Default: http://localhost:3000 (backend running on same host)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Operating Mode (required)
# Set to "saas" for hosted service with authentication and billing
# Set to "foss" for self-hosted single-user mode (no auth, no billing)
# Default: "saas"
NEXT_PUBLIC_CANARY_MODE=foss

# SAAS Mode Example:
# NEXT_PUBLIC_CANARY_MODE=saas
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# FOSS Mode Example:
# NEXT_PUBLIC_CANARY_MODE=foss
# (That's it! No additional config needed)

# Legacy Authentication Configuration (deprecated - use NEXT_PUBLIC_CANARY_MODE instead)
# NEXT_PUBLIC_AUTH_ENABLED=true

# Dashboard polling interval in seconds (optional)
# Should match the backend's CANARY_SYNC_INTERVAL
# Default: 60
NEXT_PUBLIC_SYNC_INTERVAL=60

