# Canary Frontend - Cloud Mode Configuration
# Copy this file to .env.local for hosted service deployment

#############################################
# OPERATING MODE
#############################################

# Cloud mode: Multi-user authentication, subscription billing
NEXT_PUBLIC_CANARY_MODE=cloud

#############################################
# BACKEND CONNECTION
#############################################

# For Docker deployment with Next.js API proxy:
# Leave NEXT_PUBLIC_API_URL empty - requests go through /api/* routes
# Set API_URL server-side for the proxy to reach the backend
# NEXT_PUBLIC_API_URL=
# API_URL=http://backend:3000

# For separate API server (no proxy):
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Dashboard polling interval in milliseconds (optional)
NEXT_PUBLIC_SYNC_INTERVAL=60000

# Support email address shown on subscription pages (optional, defaults to support@canarybitcoin.com)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

#############################################
# CLOUD MODE FEATURES
#############################################

# ✅ Full authentication UI (login, register, password reset)
# ✅ Subscription billing and upgrade modals
# ✅ Multi-user support with user profiles
# ✅ Customer portal integration for billing management
# ✅ Tier-based limits with proactive upgrade prompts
# ✅ Trial management and subscription status displays
# ✅ Landing page for unauthenticated users
