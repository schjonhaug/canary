# Canary Frontend - SAAS Mode Configuration
# Copy this file to .env.local for hosted service deployment

#############################################
# OPERATING MODE
#############################################

# SAAS mode: Multi-user authentication, subscription billing
NEXT_PUBLIC_CANARY_MODE=saas

#############################################
# BACKEND CONNECTION
#############################################

# Backend API URL (required)
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Dashboard polling interval in milliseconds (optional)
NEXT_PUBLIC_SYNC_INTERVAL=60000

#############################################
# STRIPE BILLING
#############################################

# Stripe Publishable Key for client-side billing (REQUIRED)
# Get this from your Stripe dashboard: https://dashboard.stripe.com/
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

#############################################
# SAAS MODE FEATURES
#############################################

# ✅ Full authentication UI (login, register, password reset)
# ✅ Subscription billing and upgrade modals
# ✅ Multi-user support with user profiles
# ✅ Customer portal integration for billing management
# ✅ Tier-based limits with proactive upgrade prompts
# ✅ Trial management and subscription status displays
# ✅ Landing page for unauthenticated users

#############################################
# EXAMPLE CONFIGURATIONS
#############################################

# For production deployment:
# NEXT_PUBLIC_API_URL=https://api.canarybitcoin.com
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# For staging deployment:
# NEXT_PUBLIC_API_URL=https://staging-api.canarybitcoin.com
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...