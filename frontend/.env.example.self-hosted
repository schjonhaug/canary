# Canary Frontend - Self-Hosted Mode Configuration
# Copy this file to .env.local for self-hosted deployment

#############################################
# OPERATING MODE
#############################################

# Self-hosted mode: Single user, no authentication, no billing
NEXT_PUBLIC_CANARY_MODE=self-hosted

#############################################
# BACKEND CONNECTION
#############################################

# Backend API URL (required)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Dashboard polling interval in milliseconds (optional)
NEXT_PUBLIC_SYNC_INTERVAL=60000

# Support email address shown on subscription pages (optional)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

#############################################
# SELF-HOSTED MODE FEATURES
#############################################

# ✅ Single hardcoded admin user (no login UI)
# ✅ No billing/subscription UI components
# ✅ No user registration or authentication flows
# ✅ Simplified interface focused on wallet management
# ✅ Direct access to wallets page (no landing page)
# ✅ No subscription limits or upgrade prompts

#############################################
# EXAMPLE CONFIGURATIONS
#############################################

# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:3000

# For Umbrel/Start9 deployment:
# NEXT_PUBLIC_API_URL=http://umbrel.local:3000

# For Docker deployment:
# NEXT_PUBLIC_API_URL=http://backend:3000
